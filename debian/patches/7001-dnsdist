@@ -0,0 +1,20 @@
+policy_module(dnsdist, 1.0.0)
+
+## declarations
+type dnsdist_t;
+type dnsdist_config_t;
+type dnsdist_exec_t;
+init_daemon_domain(dnsdist_t, dnsdist_exec_t)
+
+## local policy
+read_files_pattern(dnsdist_t, dnsdist_config_t, dnsdist_config_t)
+logging_send_syslog_msg(dnsdist_t)
+miscfiles_read_localization(dnsdist_t)
+corenet_tcp_bind_dns_port(dnsdist_t)
+corenet_tcp_bind_generic_node(dnsdist_t)
+allow dnsdist_t self:tcp_socket { create_stream_socket_perms };
+corenet_udp_bind_dns_port(dnsdist_t)
+corenet_udp_bind_generic_node(dnsdist_t)
+allow dnsdist_t self:udp_socket { create_socket_perms };
+allow dnsdist_t self:process { getcap setcap };
+kernel_read_net_sysctls(dnsdist_t)
